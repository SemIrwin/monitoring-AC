# Copier ce fichier en `.env` pour les tests locaux (jamais commité).
# En production, ces valeurs vont dans GitHub → Settings → Secrets and variables → Actions.

# URL de l'API de votre compte ActiveCampaign
# (Paramètres → Développeur → "URL" ; format : https://VOTRECOMPTE.api-us1.com)
AC_API_URL=https://votrecompte.api-us1.com

# Clé API (Paramètres → Développeur → "Clé")
AC_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
